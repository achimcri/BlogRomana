// Schema Prisma pentru blogul de limba romana.
//
// Doua constrangeri SQL Server de care depinde tot fisierul:
//  1. Prisma NU suporta `enum` pe SQL Server -> statusurile sunt String,
//     iar tipurile stricte stau in lib/types.ts si sunt validate cu Zod.
//  2. Cheile de index sunt limitate la 900 de octeti, iar String devine
//     implicit NVarChar(1000). Orice coloana cu @id, @unique sau @@index
//     are deci lungime explicita.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id        String   @id @default(cuid()) @db.NVarChar(30)
  email     String   @unique @db.NVarChar(320)
  name      String?  @db.NVarChar(200)
  image     String?  @db.NVarChar(1000)
  // TEACHER | ADMIN  (vezi Role in lib/types.ts)
  role      String   @default("TEACHER") @db.NVarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
}

model Post {
  id          String  @id @default(cuid()) @db.NVarChar(30)
  slug        String  @unique @db.NVarChar(200)
  title       String  @db.NVarChar(300)
  // HTML deja trecut prin lib/sanitize.ts. Nimic nu ajunge aici nesanitizat.
  contentHtml String  @db.NVarChar(Max)
  // Text simplu, derivat din contentHtml pentru listare si meta description.
  excerpt     String? @db.NVarChar(500)

  // DRAFT | PENDING | PUBLISHED | REJECTED
  status     String @default("PENDING") @db.NVarChar(20)
  // TEACHER | STUDENT
  authorType String @db.NVarChar(20)

  // Completat doar pentru authorType = TEACHER
  authorUserId String? @db.NVarChar(30)
  author       User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // Completate doar pentru authorType = STUDENT. Datele complete raman aici
  // pentru profesoara; ce se publica efectiv este displayName.
  studentFirstName String? @db.NVarChar(100)
  studentLastName  String? @db.NVarChar(100)
  studentClass     String? @db.NVarChar(50)

  // Numele afisat public, ex. "Maria P." Se stabileste la aprobare.
  displayName String? @db.NVarChar(200)

  rejectionReason String? @db.NVarChar(1000)

  submittedAt DateTime  @default(now())
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images PostImage[]

  // Interogarea principala: postari publicate, cele mai recente primele.
  @@index([status, publishedAt])
  @@index([status, submittedAt])
}

model PostImage {
  id     String @id @default(cuid()) @db.NVarChar(30)
  postId String @db.NVarChar(30)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Calea in containerul de Blob Storage; necesara ca sa putem sterge fisierul.
  blobName String  @db.NVarChar(500)
  url      String  @db.NVarChar(1000)
  thumbUrl String? @db.NVarChar(1000)
  caption  String? @db.NVarChar(500)
  width    Int?
  height   Int?
  // Ordinea aleasa de autor in galerie.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([postId])
}

// Un singur rand, cu id = 1. Setarile editabile de profesoara din /admin/setari.
model SiteSettings {
  id          Int     @id @default(1)
  siteTitle   String  @default("Blog de Limba Română") @db.NVarChar(200)
  siteTagline String? @db.NVarChar(500)
  aboutHtml   String? @db.NVarChar(Max)
  updatedAt   DateTime @updatedAt
}

// Cine ce a aprobat, respins sau sters. Nu se sterge niciodata.
model AuditLog {
  id         String   @id @default(cuid()) @db.NVarChar(30)
  actorEmail String   @db.NVarChar(320)
  // CREATE | EDIT | APPROVE | REJECT | DELETE | PUBLISH | UNPUBLISH
  action     String   @db.NVarChar(30)
  // Intentionat FARA relatie: logul trebuie sa supravietuiasca stergerii postarii.
  postId     String?  @db.NVarChar(30)
  postTitle  String?  @db.NVarChar(300)
  details    String?  @db.NVarChar(1000)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
