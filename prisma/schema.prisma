// Schema Prisma pentru blogul de limba romana.
//
// Baza de date: PostgreSQL (Neon in productie, Postgres in Docker local).
//
// Istoric util: pana la alegerea gazduirii, schema era pe SQL Server si purta
// doua ocolisuri care ACUM NU MAI SUNT NECESARE:
//   - lungimi explicite pe fiecare coloana indexata (SQL Server limiteaza
//     cheile de index la 900 de octeti, iar String devenea NVarChar(1000));
//   - statusuri ca String, pentru ca Prisma nu suporta `enum` pe SQL Server.
// Pe Postgres ambele dispar. Statusurile raman totusi String, validate cu Zod
// in lib/validation.ts: e mai putin rigid la adaugarea unei stari noi, care
// altfel ar cere o migrare doar pentru asta.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  // TEACHER | ADMIN (vezi Role in lib/types.ts).
  // Se rescrie la fiecare login din TEACHER_EMAILS / ADMIN_EMAILS.
  role      String   @default("TEACHER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
}

model Post {
  id    String @id @default(cuid())
  slug  String @unique
  title String
  // HTML deja trecut prin lib/sanitize.ts. Nimic nu ajunge aici nesanitizat.
  contentHtml String
  // Text simplu, pentru meta description si Open Graph.
  excerpt     String?

  // DRAFT | PENDING | PUBLISHED | REJECTED
  status String @default("PENDING")
  // TEACHER | STUDENT
  authorType String

  // Completat doar pentru authorType = TEACHER
  authorUserId String?
  author       User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  // Completate doar pentru authorType = STUDENT. Datele complete raman aici
  // pentru profesoara; ce se publica efectiv este displayName.
  studentFirstName String?
  studentLastName  String?
  studentClass     String?

  // Numele afisat public, ex. "Maria P." Se stabileste la aprobare.
  displayName String?

  rejectionReason String?

  submittedAt DateTime  @default(now())
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images PostImage[]

  // Interogarea principala: postari publicate, cele mai recente primele.
  @@index([status, publishedAt])
  @@index([status, submittedAt])
}

model PostImage {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Calea in stocarea de obiecte; necesara ca sa putem sterge fisierul.
  blobName String
  url      String
  thumbUrl String?
  caption  String?
  width    Int?
  height   Int?
  // Ordinea aleasa de autor in galerie.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([postId])
}

// Un singur rand, cu id = 1. Setarile editabile de profesoara din /admin/setari.
model SiteSettings {
  id          Int      @id @default(1)
  siteTitle   String   @default("Blog de Limba Română")
  siteTagline String?
  aboutHtml   String?
  updatedAt   DateTime @updatedAt
}

// Cine ce a aprobat, respins sau sters. Nu se sterge niciodata.
model AuditLog {
  id         String @id @default(cuid())
  actorEmail String
  // CREATE | EDIT | APPROVE | REJECT | DELETE | PUBLISH | UNPUBLISH
  action String
  // Intentionat FARA relatie: logul trebuie sa supravietuiasca stergerii postarii.
  postId    String?
  postTitle String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
