# Copiaza in .env si completeaza. .env NU se comite (vezi .gitignore).

# --- Baza de date ---
# Local (docker-compose.dev.yml):
DATABASE_URL="sqlserver://localhost:1433;database=blogromana;user=sa;password=LocalDev_Parola123;encrypt=true;trustServerCertificate=true"
# Azure SQL (productie) - encrypt=true obligatoriu, FARA trustServerCertificate:
# DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=blogromana;user=<user>;password=<parola>;encrypt=true"

# --- Autentificare (Auth.js v5) ---
# Genereaza cu: npx auth secret   (sau: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# In productie: https://domeniul-tau.ro
AUTH_URL="http://localhost:3000"

# Cine are voie sa se logheze, separat prin virgula.
# Orice cont care nu apare in niciuna din liste este respins la login.
#
# NOTA: cele doua roluri au deocamdata EXACT aceleasi drepturi. Distinctia
# e stocata corect in baza de date, ca sa putem restrange ulterior anumite
# actiuni la ADMIN, dar momentan nu schimba nimic in practica.
TEACHER_EMAILS="profesoara@exemplu.ro"
ADMIN_EMAILS=""

# --- Azure Blob Storage (poze) ---
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="post-images"
# Host-ul public al blob-urilor, pentru next/image remotePatterns:
# NEXT_PUBLIC_BLOB_HOST="<cont>.blob.core.windows.net"
NEXT_PUBLIC_BLOB_HOST=""
